# Copy to .env and adjust for your local environment.
# docker-compose.yml and the Makefile read these values.

# PostgreSQL
POSTGRES_USER=cpchat
POSTGRES_PASSWORD=cpchat
POSTGRES_DB=cpchat
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=cpchat
MINIO_ROOT_PASSWORD=cpchat-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=cp-chat-media

# Media service (Phase 2). Presigned URLs are signed against S3_PUBLIC_ENDPOINT,
# which must be reachable from the mobile client. Use http://10.0.2.2:9000 when
# running the API in Docker and testing on the Android emulator.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
SERVICE_S3_ENDPOINT=http://minio:9000
MEDIA_PRESIGN_TTL_SECONDS=900
MEDIA_MAX_BYTES=26214400
MAX_GROUP_MEMBERS=500

# Backend service configuration (used from Phase 1 onwards)
DATABASE_URL=postgres://cpchat:cpchat@localhost:5432/cpchat?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
FCM_CREDENTIALS_FILE=

# Dockerized API + gateway. Inside the Compose network the services talk to the
# `postgres` and `redis` service names, so they need their own URLs.
API_PORT=8080
GATEWAY_PUBLISHED_PORT=8081
SERVICE_DATABASE_URL=postgres://cpchat:cpchat@postgres:5432/cpchat?sslmode=disable
SERVICE_REDIS_URL=redis://redis:6379/0
LOG_LEVEL=info

# Phase 4: realtime transport. `redis` is the Phase 1-3 Pub/Sub path;
# `kafka` moves fan-out to a durable, partitioned log (start it with
# `make up-scale`, or the `kafka` profile on docker compose).
BROKER=redis
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_EVENTS_TOPIC=chat.events
KAFKA_INBOUND_TOPIC=chat.inbound
KAFKA_NUM_PARTITIONS=12
# Publish accepted sends to chat.inbound and persist them in the consumer
# instead of inline. Requires BROKER=kafka.
GATEWAY_ASYNC_INGEST=false
# Graceful WebSocket drain budget on SIGTERM (rolling deploys, scale-in).
GATEWAY_DRAIN_TIMEOUT_MS=30000

# Phase 4: message storage. `postgres` keeps the Phase 1-3 table; `scylla`
# serves history reads from Cassandra/ScyllaDB while Postgres keeps seq
# allocation, idempotency, receipts, and full-text search.
MESSAGE_STORE=postgres
SCYLLA_PORT=9042
SCYLLA_CONTACT_POINTS=localhost:9042
SCYLLA_KEYSPACE=cp_chat
SCYLLA_LOCAL_DATACENTER=datacenter1

# Phase 4: OpenTelemetry tracing (OTLP/HTTP). Off by default.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cp-chat
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_RATIO=0.1
