<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and earlier Auto Backup rules.

  E2EE identity keys, signed prekeys, ratchet sessions, and per-account local
  SQLite partitions must never leave the device through cloud backup or
  device-to-device transfer. E2EE history is intentionally non-restorable on
  new or cleared devices.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
</full-backup-content>
