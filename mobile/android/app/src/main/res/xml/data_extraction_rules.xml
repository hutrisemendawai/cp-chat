<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules.

  E2EE identity keys, signed prekeys, and ratchet sessions live in
  Keystore-backed secure storage. They must never leave the device through
  cloud backup or device-to-device transfer: a restored copy on another device
  would let that device decrypt this one's history and would fork the ratchet.
  Chat history itself is also excluded; it is re-synced from the server.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
